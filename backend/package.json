{
  "name": "@dessert-cost/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "nest build",
    "build:tests": "tsc -p tsconfig.tests.json",
    "test": "npm run build:tests && node --test .test-build/tests/*.test.js",
    "test:integration": "npm run build:tests && node --env-file-if-exists=.env --test .test-build/tests/integration/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.2",
    "@nestjs/mongoose": "12.0.1",
    "@nestjs/platform-express": "12.6.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.3.0",
    "mongoose": "9.12.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@dessert-cost/shared": "0.1.0",
    "@nestjs/cli": "11.0.17",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "12.6.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
